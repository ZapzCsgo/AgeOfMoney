generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  email         String?       @unique
  steamId       String?       @unique
  avatar        String?
  bio           String?       @db.VarChar(200)
  coins         Int           @default(0)
  totalWagered  Int           @default(0)
  provider      String
  providerId    String
  isAdmin       Boolean       @default(false)
  isMod         Boolean       @default(false)
  isPartner     Boolean       @default(false)
  isBanned      Boolean       @default(false)
  mutedUntil    DateTime?
  totpSecret    String?                         // TOTP secret for 2FA (null = not set up)
  totpEnabled   Boolean       @default(false)   // true = 2FA active
  lastIpHash    String?                         // SHA-256 of client IP (for self-referral fraud detection)
  lastIpAt      DateTime?
  lastActiveAt  DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bets          Bet[]
  transactions  Transaction[]
  rouletteBets     RouletteBet[]
  coinflipsCreated CoinFlip[]    @relation("coinflipCreator")
  coinflipsJoined  CoinFlip[]    @relation("coinflipJoiner")
  jackpotBets      JackpotBet[]
  jackpotsWon      JackpotRound[] @relation("jackpotWinner")
  trustedIps      UserTrustedIp[]

  @@unique([provider, providerId])
  @@index([totalWagered])
  @@index([isBanned])
}

// Trusted IPs pour le 2FA : quand un user a totpEnabled=true, toute requête
// sur une IP absente de cette table déclenche un challenge TOTP. Après succès,
// l'IP est ajoutée ici et les requêtes suivantes depuis la même IP passent
// sans re-demander le code.
model UserTrustedIp {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  userAgent  String?  // premier UA vu pour cette IP (debug uniquement)

  @@unique([userId, ip])
  @@index([userId])
}

model Player {
  id               String    @id @default(cuid())
  name             String    @unique
  liquipediaSlug   String    @unique
  aoe4worldId      String?
  game             String    @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  aiEnrichedGames  String[]                    // games for which Claude AI has already been called (skip credit waste)
  elo              Int       @default(1000)
  winrate          Float     @default(0.5)
  country          String?
  avatarUrl        String?
  avatarBlob       Bytes?              // downloaded LP image — served by proxy, survives redeploys
  avatarMime       String?             // e.g. "image/jpeg"
  totalGames       Int       @default(0)
  currentStreak    Int       @default(0)
  peakElo          Int?
  lastMatchAt      DateTime?
  lastUpdatedAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  matchesAsPlayer1 Match[]   @relation("Player1")
  matchesAsPlayer2 Match[]   @relation("Player2")
  matchHistory     PlayerMatchRecord[] @relation("PlayerHistory")
  opponentHistory  PlayerMatchRecord[] @relation("OpponentHistory")
  rating           PlayerRating?
}

// Glicko-2 rating system (Phase 2 odds engine — gated by ODDS_ENGINE_V2_ENABLED).
// One row per player. Updated after each match COMPLETED.
model PlayerRating {
  id           String    @id @default(cuid())
  playerId     String    @unique
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rating       Float     @default(1500)  // Glicko rating (typical range 700-2500)
  rd           Float     @default(350)   // rating deviation (uncertainty)
  vol          Float     @default(0.06)  // volatility
  gamesPlayed  Int       @default(0)
  lastUpdate   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([rating])
}

// Weekly backtest snapshots — produit par le cron weeklyOddsEngineBacktest.
// Sert à tracker Brier/accuracy dans le temps et déclencher un warning si
// V2 blended commence à battre V1 régulièrement.
model OddsBacktestSnapshot {
  id             String   @id @default(cuid())
  runAt          DateTime @default(now())
  n              Int
  v1Brier        Float
  v1LogLoss      Float
  v1Accuracy     Float
  v2Brier        Float
  v2LogLoss      Float
  v2Accuracy     Float
  v2purBrier     Float
  v2purLogLoss   Float
  v2purAccuracy  Float
  // Phase 6 — baseline Score Exact V1 (théorique binomial). Nullable parce
  // qu'ajouté après coup : les snapshots antérieurs au 2026-04-19 ne les ont
  // pas. Le check 3-semaines ignore les lignes où exactScoreRPS IS NULL.
  exactScoreRPS     Float?
  exactScoreBrier   Float?
  exactScoreLogLoss Float?
  exactScoreN       Int?
  fullReport     Json     // dump complet (buckets + worst errors + exactScore)

  @@index([runAt])
}

// Per-player tournament match history — AI-seeded or manually entered
// One record per player per match (both players get their own record)
model PlayerMatchRecord {
  id             String    @id @default(cuid())
  playerId       String
  player         Player    @relation("PlayerHistory", fields: [playerId], references: [id])
  opponentName   String
  opponentId     String?
  opponent       Player?   @relation("OpponentHistory", fields: [opponentId], references: [id])
  game           String    @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  won            Boolean
  score          String?   // "3-1" from this player's perspective
  tier           String    @default("B")   // "S" | "A" | "B" | "C" | "Qualifier" | "Misc"
  tournamentName String
  matchDate      DateTime?
  format         String?   // "BO3", "BO5"
  source         String    @default("ai") // "ai" | "manual" | "aoe4world" | "liquipedia"
  sourceUrl      String?
  confidence     Float     @default(0.8)
  createdAt      DateTime  @default(now())

  @@unique([playerId, opponentName, tournamentName, matchDate])
  @@index([playerId])
  @@index([opponentId])
  @@index([playerId, game])
}

model Tournament {
  id            String    @id @default(cuid())
  name          String
  game          String    @default("AoE4")  // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  tier          String
  prizePool     String?
  startDate     DateTime
  endDate       DateTime?
  liquipediaUrl String    @unique
  logoUrl       String?
  twitchChannel String?   // e.g. "ageofempires" for twitch.tv/ageofempires
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  matches       Match[]
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

model Match {
  id               String      @id @default(cuid())
  player1          Player      @relation("Player1", fields: [player1Id], references: [id])
  player1Id        String
  player2          Player      @relation("Player2", fields: [player2Id], references: [id])
  player2Id        String
  tournament       Tournament? @relation(fields: [tournamentId], references: [id])
  tournamentId     String?
  game             String      @default("AoE4")  // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  format           String      @default("BO3")   // BO1, BO3, BO5, BO7, BO9
  scheduledAt      DateTime
  status           MatchStatus @default(UPCOMING)
  resultScore      String?     // "2-1", "3-0", etc.
  winnerId         String?
  odds1            Float       @default(2.0)
  odds2            Float       @default(2.0)
  oddsDraw         Float?      // draw odds — only set for formats that allow draws (BO2)
  betsClosedAt     DateTime?
  betsOpen         Boolean     @default(true)    // dynamic — closed while a game is ongoing
  currentBoNumber  Int         @default(0)       // 0 = not started, 1..n = current BO game
  currentGameId    Int?        // aoe4world game_id of the game in progress
  p1Score          Int         @default(0)       // wins in this match so far
  p2Score          Int         @default(0)
  p1Civ            String?     // civ of current/last game
  p2Civ            String?
  twitchChannel    String?     // specific stream for this match if available
  liquipediaUrl    String?
  verificationFlag Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bets             Bet[]
  boResults        BoResult[]

  @@index([status, scheduledAt])
  @@index([player1Id])
  @@index([player2Id])
  @@index([tournamentId])
  @@index([winnerId])
}

model BoResult {
  id         String   @id @default(cuid())
  match      Match    @relation(fields: [matchId], references: [id])
  matchId    String
  boNumber   Int      // 1, 2, 3...
  winnerId   String?  // player DB id
  p1Civ      String?
  p2Civ      String?
  aoe4GameId Int?
  duration   Int?     // seconds
  map        String?
  startedAt  DateTime?
  endedAt    DateTime @default(now())
  createdAt  DateTime @default(now())
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
  CANCELLED
}

model Bet {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  match          Match     @relation(fields: [matchId], references: [id])
  matchId        String
  betType        String    @default("MATCH")  // "MATCH" | "BO"
  boNumber       Int?      // which BO this bet targets (null for MATCH bets)
  amount         Int
  oddsAtBet      Float
  selectedPlayer Int
  status         BetStatus @default(PENDING)
  payout         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([matchId, status])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Transaction {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  type            String   // "deposit" | "withdrawal" | "bet_win" | "bet_loss" | "refund" | "bonus"
  amount          Int      // in cents for real money, in coins for virtual
  realAmount      Int?     // in cents (€)
  coins           Int      // coins credited/debited
  stripeSessionId String?  @unique
  status          String   // "pending" | "completed" | "failed"
  affiliateCodeId String?  // affiliate code used at deposit time
  createdAt       DateTime @default(now())
}

// Historical H2H records — AI-inferred or manually sourced
// source: 'ai' | 'aoe4world' | 'manual'
model H2HRecord {
  id              String   @id @default(cuid())
  player1Id       String
  player2Id       String
  winnerId        String   // player1Id or player2Id
  score           String?  // "2-1", "3-0", etc.
  tournamentName  String?
  matchDate       DateTime?
  format          String?  // "BO3", "BO5"
  source          String   @default("ai")  // "ai" | "aoe4world" | "manual"
  sourceUrl       String?  // Liquipedia URL if available
  confidence      Float    @default(0.8)   // AI confidence 0-1
  createdAt       DateTime @default(now())

  @@unique([player1Id, player2Id, tournamentName, matchDate])
  @@index([player1Id, player2Id])
}

model ScraperLog {
  id            String   @id @default(cuid())
  source        String
  status        String
  matchesFound  Int      @default(0)
  error         String?
  duration      Int?
  createdAt     DateTime @default(now())
}

// ── Affiliate ─────────────────────────────────────────────────────────────────

model AffiliateCode {
  id             String              @id @default(cuid())
  userId         String              @unique
  code           String              @unique
  commissionRate Float               @default(0.05)  // 5% of referral deposits
  totalEarnings  Int                 @default(0)     // lifetime coins earned
  available      Int                 @default(0)     // claimable coins
  referrals      AffiliateReferral[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AffiliateReferral {
  id              String        @id @default(cuid())
  affiliateCode   AffiliateCode @relation(fields: [affiliateCodeId], references: [id])
  affiliateCodeId String
  referredUserId  String        @unique  // one referral per user
  totalDeposited  Int           @default(0)
  totalWagered    Int           @default(0)
  commission      Int           @default(0)
  // Running net loss balance for true revshare. Positive = user has net losses
  // pending commission. Negative = user is net-positive (carryover protects house).
  netLossBalance  Int           @default(0)
  isActive        Boolean       @default(false)  // active = has wagered ≥ once
  // Anti-fraud: flagged if referrer and referred user share an IP (self-referral suspicion)
  suspicious        Boolean     @default(false)
  suspiciousReason  String?
  reviewed          Boolean     @default(false)  // admin cleared the flag after review
  joinedAt        DateTime      @default(now())
  lastActiveAt    DateTime?
}

// ── Roulette ──────────────────────────────────────────────────────────────────

model RouletteRound {
  id          String         @id @default(cuid())
  status      String         @default("BETTING")  // BETTING | SPINNING | COMPLETED
  result      Int?           // 1-15 slot number
  winZone     String?        // "KNIGHTS" | "EMPEROR" | "ARCHERS"
  multiplier  Float?         // 2 | 14
  serverSeed  String?        // random hex seed — revealed after spin
  roundHash   String?        // SHA256(serverSeed) — shown during betting for verification
  startsAt    DateTime       @default(now())
  endsAt      DateTime?      // when betting closes
  spinAt      DateTime?      // when spin starts
  completedAt DateTime?
  bets        RouletteBet[]
  createdAt   DateTime       @default(now())
}

model RouletteBet {
  id        String        @id @default(cuid())
  round     RouletteRound @relation(fields: [roundId], references: [id])
  roundId   String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  zone      String        // "KNIGHTS" | "EMPEROR" | "ARCHERS"
  amount    Int           // in coins
  payout    Int?          // coins won (null until completed)
  won       Boolean?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([roundId])
}

// ── Coinflip PvP ─────────────────────────────────────────────────────────────

model CoinFlip {
  id           String    @id @default(cuid())
  creatorId    String
  creator      User      @relation("coinflipCreator", fields: [creatorId], references: [id])
  joinerId     String?
  joiner       User?     @relation("coinflipJoiner", fields: [joinerId], references: [id])
  amount       Int       // bet amount per player
  creatorSide  String    // "crown" or "shield"
  winnerId     String?
  status       String    @default("WAITING") // WAITING | FLIPPING | COMPLETED | CANCELLED
  // Provably-fair (HMAC-SHA256 commit-reveal, aligned with roulette pattern):
  //   result = HMAC_SHA256(serverSeed, clientSeed + ":" + nonce) → first 8 bytes
  //            taken as uint64, rejection-sampled to eliminate modulo bias, then % 2.
  //   seedHash = SHA256(serverSeed) is committed at creation, serverSeed revealed on completion.
  serverSeed   String    // random 32-byte hex — revealed after flip
  seedHash     String    // SHA256(serverSeed) — committed before flip
  clientSeed   String?   // public salt derived at creation, mixed into HMAC
  nonce        Int       @default(0) // per-game counter (always 0 today, reserved for future multi-roll games)
  result       String?   // "crown" or "shield"
  rake         Int       @default(0) // coins taken as house rake
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([creatorId])
  @@index([joinerId])
}

// ── Jackpot PvP (CSGO-style pot game) ────────────────────────────────────────
//
// Round lifecycle:
//   OPEN      → betting open, anyone can enter. Timer NOT started.
//   CLOSING   → 2+ participants reached, 90s countdown running (closingAt set).
//   SPINNING  → timer expired, RNG call in progress, pot locked.
//   COMPLETED → winner credited (95 %), house took rake (5 %), seeds revealed.
//   CANCELLED → only 1 participant at timer end OR API fatal error — refunded.
//
// Provably-fair (hybrid commit-reveal + Random.org Signed API when available):
//   1. At round open, generate serverSeed (32-byte hex) + publish seedHash = SHA256(serverSeed).
//   2. clientSeed = round id + serial nonce — public from the start.
//   3. When round closes, call Random.org generateSignedIntegers with
//      userData = { roundId, nonce } → get data[0] + signature.
//      rngSource = "random_org_signed", persist randomJson + randomSignature.
//   4. Fallback if Random.org unreachable (3× consecutive fails, timeout 10s,
//      or RANDOM_ORG_API_KEY absent): rngSource = "hmac_fallback",
//      winningTicket = HMAC_SHA256(serverSeed, clientSeed + ":" + nonce) % potTotal.
//   5. Winner = the bet whose [ticketFrom, ticketTo) contains winningTicket.
//   6. settledAt set, serverSeed revealed, users can verify on /fair/jackpot/:id.
model JackpotRound {
  id               String       @id @default(cuid())
  status           String       @default("OPEN")  // OPEN | CLOSING | SPINNING | COMPLETED | CANCELLED
  potTotal         Int          @default(0)       // sum of all bets in coins
  participantCount Int          @default(0)       // distinct users in round (for timer trigger)
  nonce            Int          @unique           // round serial, monotonic — feeds RNG userData
  // Provably-fair commit-reveal
  serverSeed       String                         // 32-byte hex — revealed at settle
  seedHash         String                         // SHA256(serverSeed) — committed at open
  clientSeed       String                         // public salt (round id + nonce)
  // RNG output (null until SPINNING → COMPLETED)
  rngSource        String?                        // "random_org_signed" | "hmac_fallback"
  randomJson       String?                        // exact JSON of Random.org's `random` object (signature source)
  randomSignature  String?                        // base64 RSA-SHA512 signature
  randomSerial     BigInt?                        // Random.org serialNumber
  winningTicket    Int?                           // roll result in [0, potTotal)
  winnerId         String?
  winner           User?        @relation("jackpotWinner", fields: [winnerId], references: [id])
  rake             Int          @default(0)       // 5 % of pot, credited to house
  netPayout        Int?         // potTotal - rake — credited to winner
  startedAt        DateTime     @default(now())
  closingAt        DateTime?                      // timer end — set when round transitions to CLOSING
  settledAt        DateTime?
  bets             JackpotBet[]
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([winnerId])
  @@index([createdAt])
}

// Each bet reserves a contiguous ticket range [ticketFrom, ticketTo) sized by
// the bet amount. Winner is the user whose range contains the winning ticket.
// This is the standard CSGO jackpot probability model: chance = amount / potTotal.
model JackpotBet {
  id         String       @id @default(cuid())
  round      JackpotRound @relation(fields: [roundId], references: [id])
  roundId    String
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  amount     Int          // coins wagered (min 1, max 5000 enforced in service)
  ticketFrom Int          // inclusive — equals prior potTotal at time of bet
  ticketTo   Int          // exclusive — equals ticketFrom + amount
  createdAt  DateTime     @default(now())

  @@index([roundId, createdAt])
  @@index([userId, createdAt])
}
