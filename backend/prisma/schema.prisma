generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  email                 String?                @unique
  steamId               String?                @unique
  avatar                String?
  bio                   String?                @db.VarChar(200)
  coins                 Decimal                @default(0) @db.Decimal(20, 8)
  totalWagered          Decimal                @default(0) @db.Decimal(20, 8)
  provider              String
  providerId            String
  isAdmin               Boolean                @default(false)
  isMod                 Boolean                @default(false)
  isPartner             Boolean                @default(false)
  isOwner               Boolean                @default(false) // site operator (Zapz) — strictly above ADMIN, gates /admin/finance
  isBanned              Boolean                @default(false)
  mutedUntil            DateTime?
  totpSecret            String? // TOTP secret for 2FA (null = not set up)
  totpEnabled           Boolean                @default(false) // true = 2FA active
  lastIpHash            String? // SHA-256 of client IP (for self-referral fraud detection)
  lastIpAt              DateTime?
  lastActiveAt          DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bets                  Bet[]
  transactions          Transaction[]
  rouletteBets          RouletteBet[]
  coinflipsCreated      CoinFlip[]             @relation("coinflipCreator")
  coinflipsJoined       CoinFlip[]             @relation("coinflipJoiner")
  jackpotBets           JackpotBet[]
  jackpotsWon           JackpotRound[]         @relation("jackpotWinner")
  rainsTriggered        Rain[]                 @relation("rainTriggerer")
  rainClaims            RainParticipant[]
  trustedIps            UserTrustedIp[]
  // ── Redeem codes (2026-05-02) ────────────────────────────────────────
  // Coins received via redeem code that haven't met the wagering
  // requirement yet. NOT withdrawable until the corresponding
  // RedeemCodeRedemption.unlocked flips true. Stored separately from the
  // main `coins` balance so we can keep the wagering accounting honest
  // without complicating every existing balance read.
  //
  // Cumulative wager amount applied since the user's lifetime — every
  // bet (match / coinflip / jackpot / roulette) increments this. When a
  // pending redemption's `wageringRequired` is reached, the unlock job
  // moves coins from `redeemLockedBalance` into `coins` and bumps the
  // ledger.
  redeemLockedBalance   Decimal                @default(0) @db.Decimal(20, 8)
  totalWageringProgress Decimal                @default(0) @db.Decimal(20, 8)
  redeemRedemptions     RedeemCodeRedemption[]
  redeemCodesCreated    RedeemCode[]           @relation("RedeemCodeCreator")

  @@unique([provider, providerId])
  @@index([totalWagered])
  @@index([isBanned])
}

// Trusted IPs pour le 2FA : quand un user a totpEnabled=true, toute requête
// sur une IP absente de cette table déclenche un challenge TOTP. Après succès,
// l'IP est ajoutée ici et les requêtes suivantes depuis la même IP passent
// sans re-demander le code.
model UserTrustedIp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  userAgent String? // premier UA vu pour cette IP (debug uniquement)

  @@unique([userId, ip])
  @@index([userId])
}

model Player {
  id               String              @id @default(cuid())
  name             String              @unique
  liquipediaSlug   String              @unique
  aoe4worldId      String?
  game             String              @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  aiEnrichedGames  String[] // games for which Claude AI has already been called (skip credit waste)
  elo              Int                 @default(1000)
  winrate          Float               @default(0.5)
  country          String?
  avatarUrl        String?
  avatarBlob       Bytes? // downloaded LP image — served by proxy, survives redeploys
  avatarMime       String? // e.g. "image/jpeg"
  totalGames       Int                 @default(0)
  currentStreak    Int                 @default(0)
  peakElo          Int?
  lastMatchAt      DateTime?
  lastUpdatedAt    DateTime            @default(now())
  createdAt        DateTime            @default(now())
  matchesAsPlayer1 Match[]             @relation("Player1")
  matchesAsPlayer2 Match[]             @relation("Player2")
  matchHistory     PlayerMatchRecord[] @relation("PlayerHistory")
  opponentHistory  PlayerMatchRecord[] @relation("OpponentHistory")
  rating           PlayerRating?
}

// Glicko-2 rating system (Phase 2 odds engine — gated by ODDS_ENGINE_V2_ENABLED).
// One row per player. Updated after each match COMPLETED.
model PlayerRating {
  id          String   @id @default(cuid())
  playerId    String   @unique
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rating      Float    @default(1500) // Glicko rating (typical range 700-2500)
  rd          Float    @default(350) // rating deviation (uncertainty)
  vol         Float    @default(0.06) // volatility
  gamesPlayed Int      @default(0)
  lastUpdate  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([rating])
}

// Weekly backtest snapshots — produit par le cron weeklyOddsEngineBacktest.
// Sert à tracker Brier/accuracy dans le temps et déclencher un warning si
// V2 blended commence à battre V1 régulièrement.
model OddsBacktestSnapshot {
  id                String   @id @default(cuid())
  runAt             DateTime @default(now())
  n                 Int
  v1Brier           Float
  v1LogLoss         Float
  v1Accuracy        Float
  v2Brier           Float
  v2LogLoss         Float
  v2Accuracy        Float
  v2purBrier        Float
  v2purLogLoss      Float
  v2purAccuracy     Float
  // Phase 6 — baseline Score Exact V1 (théorique binomial). Nullable parce
  // qu'ajouté après coup : les snapshots antérieurs au 2026-04-19 ne les ont
  // pas. Le check 3-semaines ignore les lignes où exactScoreRPS IS NULL.
  exactScoreRPS     Float?
  exactScoreBrier   Float?
  exactScoreLogLoss Float?
  exactScoreN       Int?
  fullReport        Json // dump complet (buckets + worst errors + exactScore)

  @@index([runAt])
}

// Per-player tournament match history — AI-seeded or manually entered
// One record per player per match (both players get their own record)
model PlayerMatchRecord {
  id             String    @id @default(cuid())
  playerId       String
  player         Player    @relation("PlayerHistory", fields: [playerId], references: [id])
  opponentName   String
  opponentId     String?
  opponent       Player?   @relation("OpponentHistory", fields: [opponentId], references: [id])
  game           String    @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  won            Boolean
  score          String? // "3-1" from this player's perspective
  tier           String    @default("B") // "S" | "A" | "B" | "C" | "Qualifier" | "Misc"
  tournamentName String
  matchDate      DateTime?
  format         String? // "BO3", "BO5"
  source         String    @default("ai") // "ai" | "manual" | "aoe4world" | "liquipedia"
  sourceUrl      String?
  confidence     Float     @default(0.8)
  createdAt      DateTime  @default(now())

  @@unique([playerId, opponentName, tournamentName, matchDate])
  @@index([playerId])
  @@index([opponentId])
  @@index([playerId, game])
}

model Tournament {
  id            String    @id @default(cuid())
  name          String
  game          String    @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  tier          String
  prizePool     String?
  startDate     DateTime
  endDate       DateTime?
  // Nullable : tournaments created from the AoE events calendar start with
  // `null` until the liquipediaScraper finds their real href in the upcoming-
  // matches federation. Postgres treats NULLs as distinct in unique indexes,
  // so multiple nulls coexist safely.
  liquipediaUrl String?   @unique
  logoUrl       String?
  twitchChannel String? // e.g. "ageofempires" for twitch.tv/ageofempires
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  matches       Match[]
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

model Match {
  id               String      @id @default(cuid())
  player1          Player      @relation("Player1", fields: [player1Id], references: [id])
  player1Id        String
  player2          Player      @relation("Player2", fields: [player2Id], references: [id])
  player2Id        String
  tournament       Tournament? @relation(fields: [tournamentId], references: [id])
  tournamentId     String?
  game             String      @default("AoE4") // "AoE4" | "AoE2" | "AoE3" | "AoM" | "AoE1"
  format           String      @default("BO3") // BO1, BO3, BO5, BO7, BO9
  scheduledAt      DateTime
  status           MatchStatus @default(UPCOMING)
  resultScore      String? // "2-1", "3-0", etc.
  winnerId         String?
  odds1            Float       @default(2.0)
  odds2            Float       @default(2.0)
  oddsDraw         Float? // draw odds — only set for formats that allow draws (BO2)
  betsClosedAt     DateTime?
  betsOpen         Boolean     @default(true) // dynamic — closed while a game is ongoing
  currentBoNumber  Int         @default(0) // 0 = not started, 1..n = current BO game
  currentGameId    Int? // aoe4world game_id of the game in progress
  p1Score          Int         @default(0) // wins in this match so far
  p2Score          Int         @default(0)
  p1Civ            String? // civ of current/last game
  p2Civ            String?
  twitchChannel    String? // specific stream for this match if available
  liquipediaUrl    String?
  verificationFlag Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bets             Bet[]
  boResults        BoResult[]

  @@index([status, scheduledAt])
  @@index([player1Id])
  @@index([player2Id])
  @@index([tournamentId])
  @@index([winnerId])
}

model BoResult {
  id         String    @id @default(cuid())
  match      Match     @relation(fields: [matchId], references: [id])
  matchId    String
  boNumber   Int // 1, 2, 3...
  winnerId   String? // player DB id
  p1Civ      String?
  p2Civ      String?
  aoe4GameId Int?
  duration   Int? // seconds
  map        String?
  startedAt  DateTime?
  endedAt    DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
  CANCELLED
}

model Bet {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  match          Match     @relation(fields: [matchId], references: [id])
  matchId        String
  betType        String    @default("MATCH") // "MATCH" | "BO"
  boNumber       Int? // which BO this bet targets (null for MATCH bets)
  amount         Decimal   @db.Decimal(20, 8)
  oddsAtBet      Float
  selectedPlayer Int
  status         BetStatus @default(PENDING)
  payout         Decimal?  @db.Decimal(20, 8)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([matchId, status])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Transaction {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  type            String // "deposit" | "withdrawal" | "bet_win" | "bet_loss" | "refund" | "bonus"
  amount          Int // USD cents — kept Int (real money side, ground truth from payment processor)
  realAmount      Int? // in cents (€)
  coins           Decimal  @db.Decimal(20, 8) // coins credited/debited (signed)
  stripeSessionId String?  @unique
  status          String // "pending" | "completed" | "failed"
  affiliateCodeId String? // affiliate code used at deposit time
  createdAt       DateTime @default(now())
}

// Historical H2H records — AI-inferred or manually sourced
// source: 'ai' | 'aoe4world' | 'manual'
model H2HRecord {
  id             String    @id @default(cuid())
  player1Id      String
  player2Id      String
  winnerId       String // player1Id or player2Id
  score          String? // "2-1", "3-0", etc.
  tournamentName String?
  matchDate      DateTime?
  format         String? // "BO3", "BO5"
  source         String    @default("ai") // "ai" | "aoe4world" | "manual"
  sourceUrl      String? // Liquipedia URL if available
  confidence     Float     @default(0.8) // AI confidence 0-1
  createdAt      DateTime  @default(now())

  @@unique([player1Id, player2Id, tournamentName, matchDate])
  @@index([player1Id, player2Id])
}

model ScraperLog {
  id           String   @id @default(cuid())
  source       String
  status       String
  matchesFound Int      @default(0)
  error        String?
  duration     Int?
  createdAt    DateTime @default(now())
}

// ── Affiliate ─────────────────────────────────────────────────────────────────

model AffiliateCode {
  id             String              @id @default(cuid())
  userId         String              @unique
  code           String              @unique
  commissionRate Float               @default(0.05) // 5% of referral deposits
  totalEarnings  Decimal             @default(0) @db.Decimal(20, 8) // lifetime coins earned
  available      Decimal             @default(0) @db.Decimal(20, 8) // claimable coins
  referrals      AffiliateReferral[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AffiliateReferral {
  id               String        @id @default(cuid())
  affiliateCode    AffiliateCode @relation(fields: [affiliateCodeId], references: [id])
  affiliateCodeId  String
  referredUserId   String        @unique // one referral per user
  totalDeposited   Decimal       @default(0) @db.Decimal(20, 8)
  totalWagered     Decimal       @default(0) @db.Decimal(20, 8)
  commission       Decimal       @default(0) @db.Decimal(20, 8)
  // Running net loss balance for true revshare. Positive = user has net losses
  // pending commission. Negative = user is net-positive (carryover protects house).
  netLossBalance   Decimal       @default(0) @db.Decimal(20, 8)
  isActive         Boolean       @default(false) // active = has wagered ≥ once
  // Anti-fraud: flagged if referrer and referred user share an IP (self-referral suspicion)
  suspicious       Boolean       @default(false)
  suspiciousReason String?
  reviewed         Boolean       @default(false) // admin cleared the flag after review
  joinedAt         DateTime      @default(now())
  lastActiveAt     DateTime?
}

// ── Roulette ──────────────────────────────────────────────────────────────────

model RouletteRound {
  id          String        @id @default(cuid())
  status      String        @default("BETTING") // BETTING | SPINNING | COMPLETED
  result      Int? // 1-15 slot number
  winZone     String? // "KNIGHTS" | "EMPEROR" | "ARCHERS"
  multiplier  Float? // 2 | 14
  serverSeed  String? // random hex seed — revealed after spin
  roundHash   String? // SHA256(serverSeed) — shown during betting for verification
  startsAt    DateTime      @default(now())
  endsAt      DateTime? // when betting closes
  spinAt      DateTime? // when spin starts
  completedAt DateTime?
  bets        RouletteBet[]
  createdAt   DateTime      @default(now())
}

model RouletteBet {
  id        String        @id @default(cuid())
  round     RouletteRound @relation(fields: [roundId], references: [id])
  roundId   String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  zone      String // "KNIGHTS" | "EMPEROR" | "ARCHERS"
  amount    Decimal       @db.Decimal(20, 8) // in coins
  payout    Decimal?      @db.Decimal(20, 8) // coins won (null until completed)
  won       Boolean?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([roundId])
}

// ── Coinflip PvP ─────────────────────────────────────────────────────────────

model CoinFlip {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation("coinflipCreator", fields: [creatorId], references: [id])
  joinerId    String?
  joiner      User?     @relation("coinflipJoiner", fields: [joinerId], references: [id])
  amount      Decimal   @db.Decimal(20, 8) // bet amount per player
  creatorSide String // "crown" or "shield"
  winnerId    String?
  status      String    @default("WAITING") // WAITING | FLIPPING | COMPLETED | CANCELLED
  // Provably-fair (HMAC-SHA256 commit-reveal, aligned with roulette pattern):
  //   result = HMAC_SHA256(serverSeed, clientSeed + ":" + nonce) → first 8 bytes
  //            taken as uint64, rejection-sampled to eliminate modulo bias, then % 2.
  //   seedHash = SHA256(serverSeed) is committed at creation, serverSeed revealed on completion.
  serverSeed  String // random 32-byte hex — revealed after flip
  seedHash    String // SHA256(serverSeed) — committed before flip
  clientSeed  String? // public salt derived at creation, mixed into HMAC
  nonce       Int       @default(0) // per-game counter (always 0 today, reserved for future multi-roll games)
  result      String? // "crown" or "shield"
  rake        Decimal   @default(0) @db.Decimal(20, 8) // coins taken as house rake
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([creatorId])
  @@index([joinerId])
}

// ── Jackpot PvP (CSGO-style pot game) ────────────────────────────────────────
//
// Round lifecycle:
//   OPEN      → betting open, anyone can enter. Timer NOT started.
//   CLOSING   → 2+ participants reached, 90s countdown running (closingAt set).
//   SPINNING  → timer expired, RNG call in progress, pot locked.
//   COMPLETED → winner credited (95 %), house took rake (5 %), seeds revealed.
//   CANCELLED → only 1 participant at timer end OR API fatal error — refunded.
//
// Provably-fair (hybrid commit-reveal + Random.org Signed API when available):
//   1. At round open, generate serverSeed (32-byte hex) + publish seedHash = SHA256(serverSeed).
//   2. clientSeed = round id + serial nonce — public from the start.
//   3. When round closes, call Random.org generateSignedIntegers with
//      userData = { roundId, nonce } → get data[0] + signature.
//      rngSource = "random_org_signed", persist randomJson + randomSignature.
//   4. Fallback if Random.org unreachable (3× consecutive fails, timeout 10s,
//      or RANDOM_ORG_API_KEY absent): rngSource = "hmac_fallback",
//      winningTicket = HMAC_SHA256(serverSeed, clientSeed + ":" + nonce) % potTotal.
//   5. Winner = the bet whose [ticketFrom, ticketTo) contains winningTicket.
//   6. settledAt set, serverSeed revealed, users can verify on /fair/jackpot/:id.
model JackpotRound {
  id               String       @id @default(cuid())
  status           String       @default("OPEN") // OPEN | CLOSING | SPINNING | COMPLETED | CANCELLED
  potTotal         Decimal      @default(0) @db.Decimal(20, 8) // sum of all bets in coins
  participantCount Int          @default(0) // distinct users in round (for timer trigger)
  nonce            Int          @unique // round serial, monotonic — feeds RNG userData
  // Provably-fair commit-reveal
  serverSeed       String // 32-byte hex — revealed at settle
  seedHash         String // SHA256(serverSeed) — committed at open
  clientSeed       String // public salt (round id + nonce)
  // RNG output (null until SPINNING → COMPLETED)
  rngSource        String? // "random_org_signed" | "hmac_fallback"
  randomJson       String? // exact JSON of Random.org's `random` object (signature source)
  randomSignature  String? // base64 RSA-SHA512 signature
  randomSerial     BigInt? // Random.org serialNumber
  winningTicket    Int? // roll result in [0, potTotal)
  winnerId         String?
  winner           User?        @relation("jackpotWinner", fields: [winnerId], references: [id])
  rake             Decimal      @default(0) @db.Decimal(20, 8) // 5 % of pot, credited to house
  netPayout        Decimal?     @db.Decimal(20, 8) // potTotal - rake — credited to winner
  startedAt        DateTime     @default(now())
  closingAt        DateTime? // timer end — set when round transitions to CLOSING
  settledAt        DateTime?
  bets             JackpotBet[]
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([winnerId])
  @@index([createdAt])
}

// Each bet reserves a contiguous ticket range [ticketFrom, ticketTo) sized by
// the bet amount. Winner is the user whose range contains the winning ticket.
// This is the standard CSGO jackpot probability model: chance = amount / potTotal.
model JackpotBet {
  id         String       @id @default(cuid())
  round      JackpotRound @relation(fields: [roundId], references: [id])
  roundId    String
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  amount     Decimal      @db.Decimal(20, 8) // coins wagered (min 1, max 5000 enforced in service)
  ticketFrom Int // inclusive — equals prior potTotal at time of bet (coin units, audit only)
  ticketTo   Int // exclusive — equals ticketFrom + amount (coin units, audit only)
  createdAt  DateTime     @default(now())

  @@index([roundId, createdAt])
  @@index([userId, createdAt])
}

// ── Rain (admin-triggered coin drop) ────────────────────────────────────────
//
// When the admin spots an engagement window ("42 users online right now,
// volume up 80 %"), they can launch a Rain : a pool of coins that users
// claim individually via a small math captcha. Coins are split equally
// across the claimants up to maxParticipants, then the window closes.
//
// At most 1 Rain is ACTIVE at any time. The rainCompleter cron (10 s)
// marks expired Rains COMPLETED and broadcasts the final stats.
//
// All claim ledger rows go through Transaction too (type='rain_claimed')
// so the finance dashboard reports the spend cleanly. The `triggeredBy`
// FK tracks which admin launched what — useful for the audit trail.
model Rain {
  id                 String            @id @default(cuid())
  triggeredBy        String
  admin              User              @relation("rainTriggerer", fields: [triggeredBy], references: [id])
  // Optional back-reference to the EventSuggestion that motivated the launch.
  // Stored as a plain String (no FK) because suggestions can be deleted or
  // archived and we want the Rain record to outlive them.
  triggeredByEvent   String?
  amount             Decimal           @db.Decimal(20, 8) // total coins pledged to the pool
  maxParticipants    Int
  duration           Int // total duration in seconds
  status             String            @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "EXPIRED"
  startedAt          DateTime          @default(now())
  endsAt             DateTime
  completedAt        DateTime?
  actualParticipants Int               @default(0)
  actualPerUser      Decimal?          @db.Decimal(20, 8) // coins credited per claimant once the pool is split
  participants       RainParticipant[]

  @@index([status, startedAt])
  @@index([triggeredBy])
}

model RainParticipant {
  id            String   @id @default(cuid())
  rainId        String
  rain          Rain     @relation(fields: [rainId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  claimedAt     DateTime @default(now())
  coinsReceived Decimal  @db.Decimal(20, 8) // credited at claim time — may be adjusted at settle if pool redivides
  captchaMs     Int // ms between captcha show and submit. < 500 → suspicious=true.
  ipHash        String? // SHA-256 of claim IP for abuse review
  suspicious    Boolean  @default(false)

  @@unique([rainId, userId])
  @@index([userId, claimedAt])
}

// ── Event Opportunities ─────────────────────────────────────────────────────
//
// Marketing radar : 8 rule-based detectors run on a 6 h cron, insert
// suggestions into this table. The owner reviews them on /admin/events
// and marks each one "acted" (with an optional note for the audit trail)
// or "dismissed" for 7 days (dismissedUntil).
//
// Dedup is composite : (ruleType, subjectKey). Subject key varies per rule :
//   - "user:${userId}"             for rules 2 (deposits_not_activated), 3 (vip_inactive), 8 (big_winner)
//   - "affiliate:${codeId}"        for rule 5 (affiliate_surge)
//   - "tournament:${tournamentId}" for rule 4 (s_tier_incoming)
//   - ""                           (empty string, singleton) for rules 1 (dau_drop), 6 (low_jackpot), 7 (volume_record)
// A fresh detection within 7 days of an existing NEW/SEEN entry with the
// same composite key is skipped so the panel doesn't spam the operator.
//
// Status lifecycle : NEW → SEEN (opened the panel) → ACTED (marked handled)
//   OR NEW → DISMISSED (dismissedUntil set, re-scans check this before
//   creating a new suggestion).
model EventSuggestion {
  id              String    @id @default(cuid())
  // v2 rule list (site-wide opportunities, not CRM) :
  // CONCURRENT_SPIKE | VOLUME_BURST | CHAT_ON_FIRE | S_TIER_INCOMING
  // | LIVE_EVENT_IN_PROGRESS | TOURNAMENT_FINAL_NEAR | WEEKEND_MOMENTUM
  // | SIGNUP_BURST_WITH_SOURCE
  // Legacy rule types from v1 (DAU_DROP, VIP_INACTIVE, AFFILIATE_SURGE,
  // BIG_WINNER, etc.) exist in DB until the cleanup script dismisses them.
  ruleType        String
  subjectKey      String // composite dedup key (see above)
  priority        String // "LOW" | "MEDIUM" | "HIGH"
  title           String
  contextData     Json // the figures that triggered the rule (rendered on the card)
  suggestedAction String
  estimatedBudget String?
  estimatedImpact String?
  // Action-oriented trio (v2) : what the operator should actually do, one
  // click away. actionType drives the primary button :
  //   "LAUNCH_RAIN"         → pre-filled RainLaunchModal
  //   "LAUNCH_ANNOUNCEMENT" → textual suggestion (infra TODO)
  //   "LAUNCH_BONUS"        → textual suggestion (infra TODO)
  //   "MANUAL"              → no primary action, just "Marquer traité"
  // actionParams carries the context needed to pre-fill the modal (e.g.
  // amount, maxParticipants, duration for a rain).
  actionType      String    @default("MANUAL")
  actionParams    Json?
  // Short one-line strings the card surfaces prominently to help the
  // operator decide fast. reasonShort = "pourquoi c'est une opportunity",
  // ifIgnoredCost = "ce qu'on perd en ne faisant rien".
  reasonShort     String?
  ifIgnoredCost   String?
  status          String    @default("NEW") // "NEW" | "SEEN" | "ACTED" | "DISMISSED"
  dismissedUntil  DateTime?
  actedAt         DateTime?
  actedNote       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([ruleType, subjectKey, createdAt])
}

// ── Redeem codes (promotional bonus distribution) ──────────────────────
// Owner (Matteo) creates codes via the admin API ; users redeem via
// POST /api/v1/redeem with the case-insensitive code string.
//
// Wagering protection : redeemed coins land in User.redeemLockedBalance
// (NOT in User.coins). Every bet placement increments the user's
// totalWageringProgress. When totalWageringProgress reaches the
// redemption's wageringRequired, the unlock job (run inside the same
// $transaction as the bet) moves the coins into User.coins and flips
// `unlocked=true`. Withdraws check User.coins only — the lockedBalance
// is invisible to the withdraw flow until it unlocks.
//
// All coin-amount fields are Decimal(20, 8) — anticipates the planned
// global Int → Decimal migration (see audit/MIGRATION_DECIMAL_PLAN_2026-05-02.md).
// Until that migration ships, the redeem-codes feature is the only place
// in the schema using Decimal — perfectly safe because every read/write
// goes through the typed redeem service which knows it's a Decimal.
model RedeemCode {
  id                    String                 @id @default(cuid())
  // Case-insensitive enforcement happens at the route level (uppercase
  // before lookup). DB column itself is plain @unique on the
  // already-uppercased value.
  code                  String                 @unique @db.VarChar(20)
  amount                Decimal                @db.Decimal(20, 8) // coins credited per redemption
  maxUses               Int? // null = unlimited
  currentUses           Int                    @default(0)
  expiresAt             DateTime?
  // If set, the user account must be at least N hours old at redemption
  // time. Anti-multi-account farming on time-gated codes.
  minAccountAgeHours    Int?
  // If set, the user account must be at most N hours old. Use for
  // genuine "WELCOME" codes reserved to fresh signups.
  maxAccountAgeHours    Int?
  // Wagering multiplier applied to `amount` to compute wageringRequired
  // on each redemption. Default 2.0 = "bet 2× the bonus before withdraw".
  // Range 1.0 → 5.0, one decimal place.
  wageringMultiplier    Decimal                @default(2.0) @db.Decimal(3, 1)
  // If set, the user must have credited at least this many coins via a
  // confirmed crypto deposit before they can redeem. Anti-bonus-abuse.
  requiresMinDeposit    Decimal?               @db.Decimal(20, 8)
  createdBy             String // user_id of the OWNER who created it
  creator               User                   @relation("RedeemCodeCreator", fields: [createdBy], references: [id])
  notes                 String?
  disabled              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  redemptions           RedeemCodeRedemption[]

  @@index([code])
  @@index([disabled, expiresAt])
}

model RedeemCodeRedemption {
  id               String     @id @default(cuid())
  codeId           String
  code             RedeemCode @relation(fields: [codeId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  amount           Decimal    @db.Decimal(20, 8) // snapshot at redemption time
  wageringRequired Decimal    @db.Decimal(20, 8) // amount * wageringMultiplier
  // Snapshot of User.totalWageringProgress at redemption time. The
  // unlock condition is `user.totalWageringProgress >= wageringStartAt
  // + wageringRequired` — this way a second redemption mid-way through
  // the first one's wagering window doesn't accidentally short-circuit.
  wageringStartAt  Decimal    @db.Decimal(20, 8)
  unlocked         Boolean    @default(false)
  // SHA-256 hash of the IP that made the redemption — never the raw IP.
  // Used for fraud detection (multiple users redeeming from the same
  // IP-hash within a short window get flagged).
  ipHash           String?
  userAgent        String? // truncated to 200 chars
  redeemedAt       DateTime   @default(now())
  unlockedAt       DateTime?

  @@unique([codeId, userId])
  @@index([userId, unlocked])
  @@index([codeId])
  @@index([ipHash, redeemedAt])
}
