# ─── Database ─────────────────────────────────────────────────────────────
# Supabase Postgres. Two connection options :
#
# 1) Direct (recommended for prod on Railway, IPv6 enabled hosts) :
#    postgresql://postgres:<pwd>@db.<project-ref>.supabase.co:5432/postgres
#
# 2) Supavisor pooler (recommended for IPv4-only devboxes — the direct
#    hostname has only AAAA records and times out on IPv4 networks). The
#    `?pgbouncer=true&connection_limit=1` query is required because
#    Supavisor in transaction mode (port 6543) does not preserve prepared
#    statements across connections.
#
#    postgresql://postgres.<project-ref>:<pwd>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL is used by Prisma for migrations only (which must NOT go
# through the transaction pooler). Set it to the direct hostname even when
# DATABASE_URL points at the pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/aoe4bet"
DIRECT_URL="postgresql://user:password@localhost:5432/aoe4bet"

# ─── App secrets ──────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-here"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# ─── Auth (Steam OAuth) ───────────────────────────────────────────────────
STEAM_SECRET=""

# ─── Payments (NOWPayments crypto, replaces Stripe) ───────────────────────
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# ─── Email (SMTP for support / notifications) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Liquipedia API (optional, recommended in prod) ───────────────────────
# Without a key we hit the public scraping path with built-in rate limits.
LIQUIPEDIA_API_KEY=""

# ─── Random.org (jackpot RNG, optional) ──────────────────────────────────
# When unset, jackpot falls back to a HMAC-derived deterministic RNG.
RANDOM_ORG_API_KEY=""

# ─── Odds engine feature flags ────────────────────────────────────────────
# Phase 1 V2 features : half-life 90j, wrLogitDiff scale 1.15, momentum
# detector, rust factor non-linéaire, SOS boost. Default OFF — backtests
# 2026-04-19 (PHASE3 / PHASE4) ont montré que V2 dégrade le baseline sur
# le dataset actuel (sparse). À ré-activer après dataset > 200 matchs.
ODDS_ENGINE_V2_ENABLED=false

# H2H priority weighting (overnight 2 — variant `s2-combo-h2h-priority`).
# When true, applies the 3 overrides that beat baseline on the
# 2026-05-02 backtest #1 (N=153) :
#   Brier 0.2061 → 0.1909 (-0.0152)
#   Accuracy 71.9% → 72.5% (+0.7pp)
#   ECE 0.2122 → 0.1951 (-0.0171)
ODDS_ENGINE_H2H_PRIORITY=false

# Bayes-weak + H2H priority (session 3 winner — variant `v45-bayes-weak-h2h`).
# Strict improvement on H2H_PRIORITY : adds priorStrength 5 → 1 on top of
# the same h2h overrides. Backtest 2026-05-02 #2 (N=153) :
#   Brier    : 0.2061 → 0.1897 (-0.0164)
#   Accuracy : 71.9% → 73.2% (+1.3 pp)
#   ECE      : 0.2122 → 0.1932 (-0.0190)
# When this flag is true, ODDS_ENGINE_H2H_PRIORITY is implied (no need to
# also set it). Recommended after 24-48 h side-by-side monitoring via
# the weekly backtest cron — see docs/ODDS_ENGINE.md.
ODDS_ENGINE_BAYES_WEAK_H2H=false

# Exact-score V2 (overround fix) — already ACTIVE in prod since 2026-04-19.
# When true, forces overround = 17.6% on every odd-BO regardless of skew.
ODDS_ENGINE_EXACT_V2_ENABLED=true

# ─── Environment ──────────────────────────────────────────────────────────
NODE_ENV="development"
