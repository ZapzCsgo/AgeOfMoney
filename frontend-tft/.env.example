# ── Backend connection ─────────────────────────────────────────────
# Same backend as AgeOfMoney — Express server on Railway. JWT issued
# by /api/v1/users/auth/login is reused across both frontends.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── next-auth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Steam OpenID ───────────────────────────────────────────────────
# Get your key at https://steamcommunity.com/dev/apikey
# IMPORTANT: register a separate Steam key for tft.money — the AoM key
# is bound to ageof.money/api/auth/callback/steam and won't accept the
# tft.money callback URL.
STEAM_SECRET=
